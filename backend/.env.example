# Copy to backend/.env for running the backend from the venv.
# Docker Compose reads this file too (it only overrides REDIS_URI to the redis container).

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- MongoDB Atlas --- tests use the same cluster, database 'meti_test'
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGO_DB=METI

# --- Redis ---
REDIS_URI=redis://localhost:6379/0

# --- Tenancy ---
DEFAULT_TENANT_SLUG=modus
DEFAULT_TENANT_NAME=Modus Enterprise Transformation

# --- Auth (Phase 2) --- JWT_SECRET: 32+ random chars, generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_PER_EMAIL=5
AUTH_RATE_LIMIT_PER_IP=30

# --- AI provider (Phase 5b+) ---
# AI_PROVIDER=anthropic  (AI_MODEL e.g. claude-sonnet-5, AI_API_KEY=sk-ant-…)
# AI_PROVIDER=openai     (OpenAI or any OpenAI-compatible API; set AI_BASE_URL for Ollama/Groq/…)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# --- Uploads (Phase 5) --- resumes, case documents, communication videos
UPLOADS_DIR=uploads

# --- Open access (bypass the paywall) ---
# FREE_ACCESS=true lets every candidate open every assessment and the Detailed Report/Roadmap
# without paying — no Stripe required. Leave false (or unset) to enforce purchases.
FREE_ACCESS=false

# --- Stripe (Phase 4) ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys (sk_test_… / pk_test_…).
# Webhook secret: from `stripe listen` (whsec_…) or a dashboard webhook endpoint to /v1/payments/webhook — optional locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
FRONTEND_URL=http://localhost:3000

# --- Voice STT/TTS (Phase 8) --- e.g. elevenlabs, azure_speech, google_speech, webspeech (webspeech needs no key)
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_API_REGION=
